{
  "name": "it-art-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/assert-production-bundle.mjs",
    "build:pages": "GITHUB_PAGES=true SITE_URL=https://amineamanzou.github.io BASE_PATH=/ItArtStudio npm run build",
    "preview": "astro preview",
    "check": "astro check && npm run assets:validate",
    "assets:validate": "node scripts/validate-asset-library.mjs",
    "qa:game": "node scripts/qa-playwright.mjs",
    "qa:game:quick": "QA_PROFILE=quick node scripts/qa-playwright.mjs",
    "qa:game:static": "QA_STATIC_DIST=true QA_STATIC_BASE_PATH=/ItArtStudio node scripts/qa-playwright.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "astro": "^6.1.9",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "three": "^0.185.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.62.0"
  }
}
