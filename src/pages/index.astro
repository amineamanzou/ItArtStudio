---
import BaseLayout from "../layouts/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const studioArtefacts = `${baseUrl}assets/studio-artefacts.png`;

const leftSocials = [
  { label: "LinkedIn", href: "https://www.linkedin.com/" },
  { label: "YouTube", href: "https://www.youtube.com/" },
  { label: "Instagram", href: "https://www.instagram.com/" },
  { label: "TikTok", href: "https://www.tiktok.com/" },
  { label: "Facebook", href: "https://www.facebook.com/" },
  { label: "Threads", href: "https://www.threads.net/" },
  { label: "X", href: "https://x.com/" }
];

const rightSocials = [
  { label: "YouTube", href: "https://www.youtube.com/" },
  { label: "Instagram", href: "https://www.instagram.com/" },
  { label: "TikTok", href: "https://www.tiktok.com/" }
];

const socialFilms = [
  { label: "Studio log", side: "IT" },
  { label: "Short format", side: "ART" },
  { label: "Build note", side: "IT" },
  { label: "Lookbook", side: "ART" },
  { label: "Behind the scenes", side: "STUDIO" }
];

const techSignals = [
  "Innovation IA",
  "Observabilité",
  "Architecture",
  "Scaling",
  "Cloud"
];

const artSignals = [
  "Direction design",
  "3D",
  "Collection de mode",
  "Image",
  "Matière"
];

const values = [
  "Exigence",
  "Clarté",
  "Transmission",
  "Présence",
  "Impact",
  "Rigueur",
  "Audace",
  "Matière",
  "Signal",
  "Soin",
  "Mouvement",
  "Justesse"
];

const valueLoop = [...values, ...values, ...values, ...values];
const reverseValueLoop = [...values].reverse().concat(values).concat([...values].reverse()).concat(values);
const alternateValueLoop = values.slice(3).concat(values).concat(values.slice(0, 6)).concat(values);
---

<BaseLayout
  title="IT Art Studio - Studio IT, Art et innovation"
  description="IT Art Studio reunit architecture tech, IA, observabilite, design, 3D et collection dans une experience vitrine cinematic scroll."
>
  <div class="cinematic-shell" style={`--studio-asset: url("${studioArtefacts}")`} data-active-track="studio">
    <header class="cinematic-nav" aria-label="Navigation principale">
      <a class="nav-brand" href="#top" aria-label="Retour a l'accueil IT Art Studio">
        <span>IT</span>
        <strong>STUDIO</strong>
        <span>ART</span>
      </a>

      <nav class="nav-links" aria-label="Sections">
        <a href="#founders">Fondateurs</a>
        <a href="#signals">Domaines</a>
        <a href="#values">Valeurs</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <nav class="mobile-track-switch" aria-label="Piste de lecture mobile">
      <button type="button" data-track-trigger="it" aria-pressed="false">IT</button>
      <button type="button" data-track-trigger="studio" aria-pressed="true">Studio</button>
      <button type="button" data-track-trigger="art" aria-pressed="false">Art</button>
    </nav>

    <main id="top">
      <section class="hero-cinematic" data-cinematic-hero aria-labelledby="hero-title">
        <canvas id="split-canvas" class="split-canvas" aria-hidden="true"></canvas>

        <div class="split-field split-field--it" aria-hidden="true"></div>

        <div class="split-field split-field--art" aria-hidden="true"></div>

        <div class="split-axis" aria-hidden="true"></div>

        <div class="studio-core" data-cinema-reveal>
          <h1 id="hero-title" aria-label="IT Art Studio">
            <span class="hero-mark-row" aria-hidden="true">
              <span>IT</span>
              <span>ART</span>
            </span>
            <strong>STUDIO</strong>
          </h1>
        </div>

        <div class="scroll-cue" aria-hidden="true">
          <span></span>
        </div>
      </section>

      <section class="founder-reveal" id="founders" data-founder-reveal aria-labelledby="founders-title">
        <h2 id="founders-title" class="sr-only">Fondateurs</h2>

        <div class="founder-stage">
          <article class="founder-half founder-half--it" data-cinema-reveal>
            <div class="portrait-frame portrait-frame--amine" aria-hidden="true">
              <span class="portrait-light"></span>
              <span class="portrait-silhouette"></span>
            </div>
            <div class="founder-caption">
              <p>Amine Amanzou</p>
              <h3>Transformer la complexité technique en systèmes lisibles, robustes et transmissibles.</h3>
            </div>
          </article>

          <div class="founder-seam" aria-hidden="true"></div>

          <article class="founder-half founder-half--art" data-cinema-reveal>
            <div class="portrait-frame portrait-frame--carine" aria-hidden="true">
              <span class="portrait-light"></span>
              <span class="portrait-silhouette"></span>
            </div>
            <div class="founder-caption">
              <p>Carine</p>
              <h3>Donner une forme sensible aux idées: image, volume, matière et collection.</h3>
            </div>
          </article>
        </div>
      </section>

      <section class="social-bridge" id="socials" aria-label="Liens sociaux">
        <div class="social-video-carousel" aria-hidden="true">
          <div class="social-video-track">
            {[...socialFilms, ...socialFilms].map((film) => (
              <figure class={`social-video-card social-video-card--${film.side.toLowerCase()}`}>
                <span>{film.side}</span>
                <figcaption>{film.label}</figcaption>
              </figure>
            ))}
          </div>
        </div>

        <div class="social-dual">
          <div class="social-list social-list--it" aria-label="Reseaux IT">
            {leftSocials.map((social) => (
            <a
              class="social-node"
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              data-cinema-reveal
            >
              <span>{social.label}</span>
            </a>
            ))}
          </div>

          <div class="social-list social-list--art" aria-label="Reseaux ART">
            {rightSocials.map((social) => (
              <a
                class="social-node"
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                data-cinema-reveal
              >
                <span>{social.label}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="domain-split" id="signals" data-domain-split aria-labelledby="signals-title">
        <h2 id="signals-title" class="sr-only">Domaines IT et ART</h2>

        <div class="domain-columns">
          <div class="domain-column domain-column--it" data-cinema-reveal>
            <h3>IT</h3>
            <p>
              Comprendre les systemes, les rendre observables, choisir les bons
              arbitrages, et faire passer l'idee du diagnostic au build.
            </p>
            <ul>
              {techSignals.map((signal, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{signal}</li>)}
            </ul>
          </div>

          <div class="domain-column domain-column--art" data-cinema-reveal>
            <h3>ART</h3>
            <p>
              Donner une forme visible aux intuitions: volume, matiere, image,
              collection, presence de marque et objets desirables.
            </p>
            <ul>
              {artSignals.map((signal, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{signal}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="shared-values" id="values" data-values aria-labelledby="values-title">
        <h2 id="values-title" class="sr-only">Valeurs communes</h2>
        <div class="values-line" aria-hidden="true"></div>
        <div class="value-marquee value-marquee--left" aria-hidden="true">
          <div class="value-track">
            {valueLoop.map((value) => <span>{value}</span>)}
          </div>
        </div>
        <div class="value-marquee value-marquee--right" aria-hidden="true">
          <div class="value-track">
            {reverseValueLoop.map((value) => <span>{value}</span>)}
          </div>
        </div>
        <div class="value-marquee value-marquee--center" aria-hidden="true">
          <div class="value-track">
            {alternateValueLoop.map((value) => <span>{value}</span>)}
          </div>
        </div>
      </section>

      <section class="contact-final" id="contact" aria-labelledby="contact-title">
        <h2 id="contact-title" class="sr-only">Contact</h2>
        <a class="contact-split-button" href="mailto:contact@itart.studio">
          <span>Contactez</span>
          <span>-nous</span>
        </a>
      </section>
    </main>
  </div>
</BaseLayout>
