---
import { company, methodSteps, references, services } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const itServices = services.filter((service) => service.practice === "IT");
const artServices = services.filter((service) => service.practice === "ART");
const assetBase = import.meta.env.BASE_URL.endsWith("/")
  ? `${import.meta.env.BASE_URL}assets`
  : `${import.meta.env.BASE_URL}/assets`;
---

<BaseLayout splitAxis>
  <main id="contenu">
    <section class="hero-scroll" data-hero-scroll aria-labelledby="hero-title">
      <div class="hero-scroll__stage">
        <video
          class="hero-scroll__media"
          data-hero-video
          muted
          playsinline
          preload="metadata"
          poster={`${assetBase}/hero-scroll-poster.jpg`}
          aria-hidden="true"
          tabindex="-1"
        >
          <source src={`${assetBase}/hero-scroll.webm`} type="video/webm" />
          <source src={`${assetBase}/hero-scroll.mp4`} type="video/mp4" />
        </video>

        <div class="hero-scroll__shade" aria-hidden="true"></div>

        <article class="hero-scroll__practice hero-scroll__practice--art">
          <p>ART</p>
          <h2>Définir un langage visuel. Produire les images, les films et les objets.</h2>
          <a href="#expertises-art">Voir la pratique ART</a>
        </article>

        <article class="hero-scroll__practice hero-scroll__practice--it">
          <p>IT</p>
          <h2>Comprendre le système. Construire ce qui doit fonctionner.</h2>
          <a href="#expertises-it">Voir la pratique IT</a>
        </article>

        <div class="hero-scroll__core">
          <h1 id="hero-title">
            <span class="hero-title__it">IT</span>
            <span class="hero-title__art">ART</span>
            <strong class="hero-title__studio">STUDIO</strong>
          </h1>
        </div>

        <div class="hero-scroll__progress" aria-hidden="true">
          <span>Défiler</span>
          <i><b></b></i>
        </div>
      </div>
    </section>

    <section class="activity-section" aria-label="Les deux pratiques du studio">
      <article class="activity-practice activity-practice--art">
        <p class="activity-section__lead">ART</p>
        <h2>Direction et production visuelles.</h2>
        <p>
          La pratique ART conçoit des directions visuelles, des images, des films et des animations
          3D, ainsi que des pièces et des collections capsules.
        </p>
      </article>
      <article class="activity-practice activity-practice--it">
        <p class="activity-section__lead">IT</p>
        <h2>Conseil technique.</h2>
        <p>
          IT Art Studio est un studio indépendant de conseil et de production. La pratique IT
          intervient sur l'architecture cloud, l'observabilité, l'IA appliquée et la formation.
        </p>
      </article>
    </section>

    <section class="services-section" id="expertises" aria-labelledby="services-title">
      <header class="section-heading">
        <h2 id="services-title">Chaque mission se termine par quelque chose d'utilisable.</h2>
        <p>Le livrable peut être une architecture, un prototype, une équipe formée, une image ou une collection.</p>
      </header>

      <div class="practice-columns">
        <div class="practice-services practice-services--art" id="expertises-art">
          <header>
            <span>Pratique ART</span>
            <p>Direction visuelle · 3D · contenus · collections</p>
          </header>
          <div class="service-list">
            {artServices.map((service, index) => (
              <article class="service-item">
                <span>{String(index + 5).padStart(2, "0")}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="practice-services practice-services--it" id="expertises-it">
          <header>
            <span>Pratique IT</span>
            <p>Architecture · observabilité · cloud · IA</p>
          </header>
          <div class="service-list">
            {itServices.map((service, index) => (
              <article class="service-item">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="references-section" id="references" aria-labelledby="references-title">
      <header>
        <p>Références</p>
        <h2 id="references-title">Des organisations accompagnées sur des projets critiques qui nous font confiance.</h2>
      </header>
      <div class="references-practices">
        <section class="references-practice references-practice--art" aria-labelledby="references-art-title">
          <h3 id="references-art-title">ART</h3>
        </section>
        <section class="references-practice references-practice--it" aria-labelledby="references-it-title">
          <h3 id="references-it-title">IT</h3>
          <ul>
            {references.it.map((reference) => <li>{reference}</li>)}
          </ul>
        </section>
      </div>
    </section>

    <section class="method-section" id="approche" aria-labelledby="method-title">
      <header>
        <h2 id="method-title">Un déroulé lisible, quel que soit le projet.</h2>
      </header>
      <ol>
        {methodSteps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="contact-section__intro">
        <p>Un système à fiabiliser, un prototype à tester ou une direction visuelle à produire ?</p>
        <h2 id="contact-title">Écrire au studio.</h2>
      </div>
      <div class="contact-section__action">
        <p>Quelques lignes suffisent : le contexte, l'échéance et le livrable attendu.</p>
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </div>
    </section>
  </main>

  <script>
    import { initHeroScroll } from "../scripts/hero-scroll";

    initHeroScroll();
  </script>
</BaseLayout>
