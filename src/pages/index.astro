---
import { company, methodSteps, references, services } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const itServices = services.filter((service) => service.practice === "IT");
const artServices = services.filter((service) => service.practice === "ART");
const assetBase = import.meta.env.BASE_URL.endsWith("/")
  ? `${import.meta.env.BASE_URL}assets`
  : `${import.meta.env.BASE_URL}/assets`;
---

<BaseLayout splitAxis>
  <main id="contenu">
    <section class="hero-scroll" data-hero-scroll aria-labelledby="hero-title">
      <div class="hero-scroll__stage">
        <video
          class="hero-scroll__media"
          data-hero-video
          muted
          playsinline
          preload="metadata"
          poster={`${assetBase}/hero-scroll-poster.jpg`}
          aria-hidden="true"
          tabindex="-1"
        >
          <source src={`${assetBase}/hero-scroll.webm`} type="video/webm" />
          <source src={`${assetBase}/hero-scroll.mp4`} type="video/mp4" />
        </video>

        <div class="hero-scroll__shade" aria-hidden="true"></div>

        <article class="hero-scroll__practice hero-scroll__practice--art">
          <p>ART</p>
          <h2>Définir un langage visuel. Produire les images, les films et les objets.</h2>
          <a href="#expertises-art">Voir la pratique ART</a>
        </article>

        <article class="hero-scroll__practice hero-scroll__practice--it">
          <p>IT</p>
          <h2>Comprendre le système. Construire ce qui doit fonctionner.</h2>
          <a href="#expertises-it">Voir la pratique IT</a>
        </article>

        <div class="hero-scroll__core">
          <h1 id="hero-title">
            <span class="hero-title__it">IT</span>
            <span class="hero-title__art">ART</span>
            <strong class="hero-title__studio">STUDIO</strong>
          </h1>
        </div>

        <div class="hero-scroll__progress" aria-hidden="true">
          <span>Défiler</span>
          <i><b></b></i>
        </div>
      </div>
    </section>

    <section class="services-section" id="expertises" aria-labelledby="services-title">
      <h2 class="visually-hidden" id="services-title">Prestations ART et IT</h2>

      <div class="practice-columns">
        <div class="practice-services practice-services--art" id="expertises-art">
          <div class="service-list">
            {artServices.map((service, index) => (
              <article
                class="service-item"
                data-reveal="split-left"
                data-reveal-kind="service"
                style={`--reveal-index: ${index}`}
              >
                <span>{String(index + 5).padStart(2, "0")}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="practice-services practice-services--it" id="expertises-it">
          <div class="service-list">
            {itServices.map((service, index) => (
              <article
                class="service-item"
                data-reveal="split-right"
                data-reveal-kind="service"
                style={`--reveal-index: ${index}`}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="references-section" id="references" aria-labelledby="references-title">
      <h2 class="visually-hidden" id="references-title">Références ART et IT</h2>
      <div class="references-practices">
        <section class="references-practice references-practice--art" aria-labelledby="references-art-title">
          <h3 id="references-art-title" data-reveal="split-left">ART</h3>
          <ul>
            {references.art.map((reference, index) => (
              <li
                class:list={["reference-mark", reference.treatment && `reference-mark--${reference.treatment}`]}
                data-reveal="split-left"
                data-reveal-kind="logo"
                style={`--reveal-index: ${index}`}
              >
                <span class="reference-mark__visual">
                  <img src={reference.logo} alt={`Logo ${reference.name}`} loading="eager" decoding="async" />
                </span>
                <span class="reference-mark__name">{reference.name}</span>
              </li>
            ))}
          </ul>
        </section>
        <section class="references-practice references-practice--it" aria-labelledby="references-it-title">
          <h3 id="references-it-title" data-reveal="split-right">IT</h3>
          <ul>
            {references.it.map((reference, index) => (
              <li
                class:list={["reference-mark", reference.treatment && `reference-mark--${reference.treatment}`]}
                data-reveal="split-right"
                data-reveal-kind="logo"
                style={`--reveal-index: ${index}`}
              >
                <span class="reference-mark__visual">
                  <img src={reference.logo} alt={`Logo ${reference.name}`} loading="eager" decoding="async" />
                </span>
                <span class="reference-mark__name">{reference.name}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>

    <section class="method-section" id="approche" aria-labelledby="method-title">
      <header>
        <h2 id="method-title">
          <span class="method-title__left" data-reveal="split-left">Un déroulé lisible</span>
          <span class="method-title__right" data-reveal="split-right">quel que soit le projet.</span>
        </h2>
      </header>
      <ol>
        {methodSteps.map((step, index) => (
          <li
            class={`method-step method-step--${step.side}`}
            data-reveal={`split-${step.side}`}
            style={`--reveal-index: ${index}`}
          >
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="contact-section" id="contact" aria-label="Contacter IT Art Studio">
      <article class="contact-practice contact-practice--art" data-reveal="split-left">
        <h2>Besoin de notre art ?</h2>
        <a href={`mailto:${company.artEmail}`}>{company.artEmail}</a>
      </article>
      <article class="contact-practice contact-practice--it" data-reveal="split-right">
        <h2>Besoin de notre tech ?</h2>
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </article>
    </section>
  </main>

  <script>
    import { initHeroScroll } from "../scripts/hero-scroll";
    import { initSectionReveals } from "../scripts/section-reveals";

    initHeroScroll();
    initSectionReveals();
  </script>
</BaseLayout>
