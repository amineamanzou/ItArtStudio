---
import BaseLayout from "../layouts/BaseLayout.astro";
import { defaultZone, zones } from "../game/zones";
import { worldSize } from "../game/world-config";

const mapRange = worldSize;
const mapCoordinate = (value: number) => `${((value + mapRange / 2) / mapRange) * 100}%`;
const mapPinOffsets: Record<string, [number, number]> = {
  "cloud-dock": [-10, -8],
  "values-plaza": [0, 18],
  "contact-portal": [10, 8]
};
const homeHref = import.meta.env.BASE_URL;
---

<BaseLayout
  title="IT Art Studio - agence tech creative jouable"
  description="Explorez IT Art Studio comme une carte de jeu video: IA, observabilite, architecture, cloud, design, 3D, mode et valeurs communes."
>
  <main class="game-site" data-game-root>
    <section class="studio-game" aria-labelledby="game-title">
      <canvas id="studio-map-canvas" class="studio-map-canvas" aria-hidden="true"></canvas>

      <header class="game-hud" aria-label="Navigation principale">
        <a class="game-brand" href={homeHref} aria-label="IT Art Studio">
          <span>IT</span>
          <strong>ART</strong>
          <em>STUDIO</em>
        </a>
        <div class="game-status" aria-live="polite">
          <span data-active-kind>{defaultZone.kind}</span>
          <strong data-active-label>{defaultZone.label}</strong>
        </div>
        <button class="game-audio" type="button" data-audio-toggle aria-pressed="false" aria-label="Activer le son">
          Son
        </button>
        <a class="game-contact" href="mailto:contact@itart.studio">Contact</a>
      </header>

      <div class="intro-plate" data-intro-plate>
        <p>Carte jouable</p>
        <h1 id="game-title">IT Art Studio</h1>
        <span>Explorez la frontiere entre systemes robustes et formes sensibles.</span>
      </div>

      <aside class="zone-panel" aria-labelledby="zone-title" data-zone-panel>
        <p class="zone-panel__kind" data-zone-kind>{defaultZone.kind}</p>
        <h2 id="zone-title" data-zone-title>{defaultZone.title}</h2>
        <p class="zone-panel__summary" data-zone-summary>{defaultZone.summary}</p>
        <p class="zone-panel__details" data-zone-details>{defaultZone.details}</p>
        <ul class="zone-panel__signals" data-zone-signals>
          {defaultZone.signals.map((signal) => <li>{signal}</li>)}
        </ul>
        <a
          class="zone-panel__cta"
          href={defaultZone.cta ?? "#"}
          data-zone-cta
          aria-hidden={defaultZone.cta ? "false" : "true"}
        >
          Contactez-nous
        </a>
      </aside>

      <nav class="world-map" aria-label="Carte des zones">
        <span class="world-map__axis world-map__axis--x" aria-hidden="true"></span>
        <span class="world-map__axis world-map__axis--y" aria-hidden="true"></span>
        <span class="world-map__player" data-map-player aria-hidden="true"></span>
        {zones.map((zone, index) => {
          const [offsetX, offsetY] = mapPinOffsets[zone.id] ?? [0, 0];
          return (
          <button
            class={`world-map__pin world-map__pin--${zone.kind}`}
            type="button"
            data-zone-jump={zone.id}
            aria-label={`Aller a ${zone.label}`}
            aria-pressed={zone.id === defaultZone.id ? "true" : "false"}
            style={`left: ${mapCoordinate(zone.position[0])}; top: ${mapCoordinate(zone.position[1])}; --map-order: ${index + 1}; --map-offset-x: ${offsetX}px; --map-offset-y: ${offsetY}px;`}
          >
            <span>{zone.shortLabel}</span>
          </button>
          );
        })}
      </nav>

      <nav class="mobile-zone-nav" aria-label="Zones du studio">
        {zones.map((zone) => (
          <button
            class={`mobile-zone-nav__item mobile-zone-nav__item--${zone.kind}`}
            type="button"
            data-zone-jump={zone.id}
            aria-label={`Aller a ${zone.label}`}
            aria-pressed={zone.id === defaultZone.id ? "true" : "false"}
          >
            {zone.shortLabel}
          </button>
        ))}
      </nav>

      <div class="mobile-drive" aria-label="Deplacement mobile">
        <button type="button" data-drive="up" aria-label="Avancer">↑</button>
        <button type="button" data-drive="left" aria-label="Tourner a gauche">←</button>
        <button type="button" data-drive="down" aria-label="Reculer">↓</button>
        <button type="button" data-drive="right" aria-label="Tourner a droite">→</button>
      </div>

      <div class="game-loader" data-game-loader aria-live="polite">Chargement de la carte</div>
    </section>

    <section class="fallback-zone-list" aria-labelledby="fallback-title">
      <h2 id="fallback-title">Explorer le studio sans WebGL</h2>
      <div>
        {zones.map((zone) => (
          <article>
            <p>{zone.kind}</p>
            <h3>{zone.title}</h3>
            <p>{zone.summary}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
