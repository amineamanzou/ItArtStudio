---
import { company, methodSteps, services } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const itServices = services.filter((service) => service.practice === "IT");
const artServices = services.filter((service) => service.practice === "ART");
const assetBase = import.meta.env.BASE_URL.endsWith("/")
  ? `${import.meta.env.BASE_URL}assets`
  : `${import.meta.env.BASE_URL}/assets`;
---

<BaseLayout>
  <main id="contenu">
    <section class="hero" aria-labelledby="hero-title">
      <article class="hero-practice hero-practice--it">
        <picture class="hero-practice__media">
          <source srcset={`${assetBase}/hero-it.avif`} type="image/avif" />
          <source srcset={`${assetBase}/hero-it.webp`} type="image/webp" />
          <img src={`${assetBase}/hero-it.jpg`} alt="Architecture technique sombre traversée de signaux cyan" width="1920" height="1080" />
        </picture>
        <div class="hero-practice__copy">
          <p>IT</p>
          <h2>Clarifier les systèmes. Fiabiliser l'exécution.</h2>
          <a href="#expertises-it">Explorer la pratique IT</a>
        </div>
      </article>

      <article class="hero-practice hero-practice--art">
        <picture class="hero-practice__media">
          <source srcset={`${assetBase}/hero-art.avif`} type="image/avif" />
          <source srcset={`${assetBase}/hero-art.webp`} type="image/webp" />
          <img src={`${assetBase}/hero-art.jpg`} alt="Atelier sombre composé de matière, de volume et d'outils cuivrés" width="1920" height="1080" />
        </picture>
        <div class="hero-practice__copy">
          <p>ART</p>
          <h2>Donner une forme. Installer une présence.</h2>
          <a href="#expertises-art">Explorer la pratique ART</a>
        </div>
      </article>

      <div class="hero-core">
        <h1 id="hero-title"><span>IT</span> <strong>STUDIO</strong> <span>ART</span></h1>
        <p>Transformer la complexité en exécution nette.</p>
      </div>
    </section>

    <section class="activity-section" aria-labelledby="activity-title">
      <p class="activity-section__lead">Conseil · conception · création</p>
      <div>
        <h2 id="activity-title">Deux pratiques réunies par une même exigence de fond.</h2>
        <p>
          IT Art Studio accompagne les organisations et les porteurs de projets dans leurs sujets
          informatiques et audiovisuels : conseil, formation, architecture, observabilité,
          prototypes, design 3D, contenus et collections. Nous intervenons là où il faut comprendre,
          construire et rendre la valeur visible.
        </p>
      </div>
    </section>

    <section class="services-section" id="expertises" aria-labelledby="services-title">
      <header class="section-heading">
        <h2 id="services-title">Des interventions concrètes, du diagnostic au rendu.</h2>
        <p>Une lecture senior des contraintes, puis le livrable utile pour avancer.</p>
      </header>

      <div class="practice-services practice-services--it" id="expertises-it">
        <header>
          <span>Pratique IT</span>
          <p>Systèmes · produit · transmission</p>
        </header>
        <div class="service-list">
          {itServices.map((service, index) => (
            <article class="service-item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="practice-services practice-services--art" id="expertises-art">
        <header>
          <span>Pratique ART</span>
          <p>Volume · image · matière</p>
        </header>
        <div class="service-list">
          {artServices.map((service, index) => (
            <article class="service-item">
              <span>{String(index + 5).padStart(2, "0")}</span>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="method-section" id="approche" aria-labelledby="method-title">
      <header>
        <h2 id="method-title">Une méthode simple pour des sujets qui ne le sont pas.</h2>
      </header>
      <ol>
        {methodSteps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <p>Un sujet à clarifier, construire ou mettre en valeur ?</p>
      <h2 id="contact-title">Parlons de votre projet.</h2>
      <a href={`mailto:${company.email}`}>{company.email}</a>
    </section>
  </main>
</BaseLayout>
